// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-outside-of-docker-compose
{
	"name": "Docker from Docker Compose",
	"dockerComposeFile": [
		"../docker-compose.yml",
		"docker-compose.dev.yml",
		"../docker-compose.override.yml"
	],
	"service": "dev",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteEnv": {
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
		"DJANGO_SETTINGS_MODULE": "main.settings",
		"SETTINGS_FILES_FOR_DYNACONF": "/etc/pdfactory/settings.yml",
		"ENVIRONMENTS_FOR_DYNACONF": "false"
	},
	"mounts": [
		{
			"type": "bind",
			"source": "${localWorkspaceFolder}/.devcontainer/settings.yml",
			"target": "/etc/pdfactory/settings.yml"
		},
		{
			"type": "volume",
			"source": "media_data",
			"target": "/workspaces/${localWorkspaceFolderBasename}/src/media"
		},
		{
			"type": "volume",
			"source": "static_data",
			"target": "/workspaces/${localWorkspaceFolderBasename}/src/static"
		}
	],
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.9.1": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "false"
		},
		"ghcr.io/devcontainers/features/python:1.8.0": {
			"version": "3.14"
		},
		"ghcr.io/devcontainers-extra/features/poetry:2.0.18": {
			"version": "2.3.2"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff"
				},
				"pylint.importStrategy": "fromEnvironment",
				"mypy-type-checker.importStrategy": "fromEnvironment",
				"ruff.importStrategy": "fromEnvironment",
				"python-envs.defaultEnvManager": "ms-python.python:poetry",
				"python-envs.defaultPackageManager": "ms-python.python:poetry",
				"launch": {
					"version": "0.2.0",
					"configurations": [
						{
							"name": "Backend: Django",
							"type": "debugpy",
							"request": "attach",
							"connect": {
								"host": "django",
								"port": 5678
							},
							"django": true,
							"justMyCode": false,
							"pathMappings": [
								{
									"localRoot": "${workspaceFolder}/src/",
									"remoteRoot": "/usr/src/app/"
								},
								{
									"localRoot": "${workspaceFolder}/.venv/lib/python3.14/site-packages/",
									"remoteRoot": "/home/wodby/.local/lib/python3.14/site-packages/"
								}
							]
						}
					],
					"compounds": [
						{
							"name": "Backend",
							"configurations": [
								"Backend: Django"
							]
						}
					]
				}
			},
			"extensions": [
				"PyCQA.bandit-pycqa",
				"streetsidesoftware.code-spell-checker",
				"tamasfe.even-better-toml",
				"ms-python.mypy-type-checker",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.vscode-python-envs",
				"charliermarsh.ruff",
				"redhat.vscode-yaml",
				"github.vscode-github-actions",
				"GitHub.vscode-pull-request-github"
			]
		}
	},
	"postCreateCommand": "poetry install"
}